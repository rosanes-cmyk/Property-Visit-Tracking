{
  "login": {
    "urlFragments": ["login", "signin", "auth"],
    "passwordSelectors": ["input[type='password']"]
  },
  "listItemLabels": {
    "_comment": "Primary strategy. REI renders each field as a leaf [data-testid='list-item'] whose text is Label+Value glued together; the scraper matches these label prefixes and returns the remainder. Verified against a real REI contact page.",
    "sellerName": ["Name"],
    "phone": ["Phone (Mobile)", "Phone (Home)", "Phone"],
    "email": ["Email"],
    "propertyAddress": ["Property Address"],
    "appointmentTime": ["Appointment Time"],
    "appointmentDate": ["Appointment Date"],
    "assignedOwner": ["Appointment Assigned To", "Sales Agent"],
    "leadSource": ["Source"],
    "contactStage": ["Lead Stage", "Category"],
    "nextAction": ["Next Step"],
    "callDisposition": ["Call Disposition"],
    "amountOffer": ["Amount Offer"]
  },
  "fields": {
    "sellerName": [
      "[data-testid='contact-name']",
      "[data-test='contact-name']",
      "[class*='contact-name']",
      "h1"
    ],
    "phone": [
      "a[href^='tel:']",
      "[data-testid='phone']",
      "[class*='phone']"
    ],
    "email": [
      "a[href^='mailto:']",
      "[data-testid='email']",
      "[class*='email']"
    ],
    "propertyAddress": [
      "[data-testid='property-address']",
      "[data-test='property-address']",
      "[class*='property-address']",
      "[class*='address']"
    ],
    "appointmentDateTime": [
      "[data-testid='appointment-date']",
      "[data-testid='task-due-date']",
      "[data-test='task-due-date']",
      "time"
    ],
    "assignedOwner": [
      "[data-testid='assigned-user']",
      "[data-test='assigned-user']",
      "[class*='assigned']"
    ],
    "taskTitle": [
      "[data-testid='task-title']",
      "[data-test='task-title']",
      "[class*='task-title']"
    ],
    "taskStatus": [
      "[data-testid='task-status']",
      "[data-test='task-status']",
      "[class*='task-status']"
    ],
    "contactStage": [
      "[data-testid='contact-stage']",
      "[data-test='contact-stage']",
      "[class*='stage']"
    ],
    "leadSource": [
      "[data-testid='lead-source']",
      "[data-test='lead-source']",
      "[class*='source']"
    ],
    "nextAction": [
      "[data-testid='next-action']",
      "[data-test='next-action']",
      "[class*='next-action']"
    ]
  },
  "labels": {
    "sellerName": ["Contact Name", "Seller Name", "Name"],
    "phone": ["Phone", "Mobile", "Primary Phone"],
    "email": ["Email", "Primary Email"],
    "propertyAddress": ["Property Address", "Address"],
    "appointmentDateTime": ["Appointment", "Appointment Date", "Due Date", "Visit Date", "Start"],
    "assignedOwner": ["Assigned To", "Owner", "Sales Agent"],
    "taskTitle": ["Task", "Task Title", "Title"],
    "taskStatus": ["Task Status", "Status"],
    "contactStage": ["Lead Stage", "Contact Stage", "Stage"],
    "leadSource": ["Lead Source", "Source"],
    "nextAction": ["Next Action", "Next Step"]
  },
  "tabs": {
    "notes": ["Notes", "Contact Notes"],
    "tasks": ["Tasks", "Appointments"],
    "activity": ["Activity", "Timeline", "History"],
    "property": ["Property", "Properties"]
  },
  "collectionSelectors": {
    "notes": [
      "[data-testid='note-item']",
      "[data-test='note-item']",
      "[class*='note-item']",
      "[class*='note-card']"
    ],
    "activity": [
      "[data-testid='activity-item']",
      "[data-test='activity-item']",
      "[class*='activity-item']",
      "[class*='timeline-item']"
    ],
    "propertyDetails": [
      "[data-testid='property-details']",
      "[data-test='property-details']",
      "[class*='property-detail']"
    ]
  }
}
