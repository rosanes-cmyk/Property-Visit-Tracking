{
  "_comment": "CONFIRMED against a live WhatsApp Web session on 2026-08-03 via `node scripts/whatsapp-doctor.mjs`: chatList, searchBox, newChatButton, newGroupButton and participantResults. participantSearch targets the CONTAINER [data-testid='inputarea'] on purpose - the editable element inside it has no testid/aria-label/title, so nothing selects it reliably; the client clicks the container and types through the keyboard instead. nextButton, groupSubjectInput and createGroupButton remain candidates: they only render after a participant is picked. Nothing here may match a send/delete/leave control - client.mjs refuses those.",
  "chatList": [
    "[data-testid='chat-list']",
    "[aria-label='Chat list']",
    "#pane-side"
  ],
  "searchBox": [
    "[aria-label='Search or start a new chat']",
    "[data-testid='chat-list-search-container'] div[contenteditable='true']",
    "[data-testid='chat-list-search'] div[contenteditable='true']",
    "div[contenteditable='true'][data-tab='3']"
  ],
  "searchResultTitles": [
    "[data-testid='cell-frame-title'] span[title]",
    "[data-testid='cell-frame-title']",
    "[data-testid='cell-frame-container'] span[title]"
  ],
  "newChatButton": [
    "[aria-label='New chat']",
    "[title='New chat']",
    "[data-testid='new-chat-outline']"
  ],
  "newGroupButton": [
    "[aria-label='New group']",
    "[data-testid='new-group']",
    "li:has-text('New group')"
  ],
  "participantSearch": [
    "[data-testid='new-group-drawer-participants'] [data-testid='inputarea']",
    "[data-testid='new-group-drawer-participants'] [contenteditable='true']",
