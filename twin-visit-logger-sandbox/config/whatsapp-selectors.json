    "[data-testid='inputarea']",
    "[aria-label='Search name or number']"
  ],
  "participantResults": [
    "[data-testid='new-group-drawer-participants'] [data-testid='cell-frame-container']",
    "[data-testid='cell-frame-container']",
    "[data-testid^='list-item-']"
  ],
  "nextButton": [
    "[data-testid='drawer-left'] [aria-label='Next']",
    "[aria-label='Next']",
    "[data-testid='arrow-forward']",
    "span[data-icon='arrow-forward']",
