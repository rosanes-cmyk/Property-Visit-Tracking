  "propertyFacts": {
    "_comment": "Beds / baths / square footage appear as their own text chips - '4 Beds', '2.0 Baths', '2,448 SqFt' - not as label/value pairs, so they are matched by pattern rather than by label.",
    "patterns": {
      "beds": "(\\d+(?:\\.\\d+)?)\\s*Beds?\\b",
      "baths": "(\\d+(?:\\.\\d+)?)\\s*Baths?\\b",
