# Google Cloud desktop OAuth credential downloaded from Google Cloud Console.
GOOGLE_CREDENTIALS_PATH=./credentials/credentials.json
GOOGLE_TOKEN_PATH=./credentials/token.json

# Gmail query. Keep this narrow in the sandbox to avoid processing old mail.
GMAIL_QUERY=newer_than:2d ("Booked appointment" OR "Rescheduled appointment" OR "Cancelled appointment" OR "Canceled appointment") -label:THB-VisitLogger-Processed -label:THB-VisitLogger-Error
GMAIL_PROCESSED_LABEL=THB-VisitLogger-Processed
GMAIL_ERROR_LABEL=THB-VisitLogger-Error
REI_URL_PATTERN=reiblackbook
MAX_EMAILS_PER_RUN=10

# Sandbox Google Sheet. Use the DEV copy spreadsheet ID, not the production sheet.
SPREADSHEET_ID=PASTE_SANDBOX_SPREADSHEET_ID
TRACKER_SHEET=Visit Tracker DEV
TRACKER_HEADER_ROW=1
ADD_MISSING_COLUMNS=true

# Calendar. "primary" is allowed, but a dedicated sandbox calendar is safer.
CALENDAR_ID=primary
CALENDAR_TIMEZONE=America/Los_Angeles
DEFAULT_VISIT_DURATION_MINUTES=60

# Persistent Playwright profile. Never commit this directory.
REI_USER_DATA_DIR=./browser-data/rei-sandbox
REI_LOGIN_URL=https://my.reiblackbook.com/
REI_HEADLESS=false
REI_PAGE_TIMEOUT_MS=45000
REI_SELECTOR_CONFIG=./config/rei-selectors.json

# Processing behavior.
POLL_INTERVAL_MINUTES=5
STRICT_VALIDATION=true
DRY_RUN=false
DEBUG_CAPTURE=true
LOG_LEVEL=info
