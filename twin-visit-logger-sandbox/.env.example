# Google Cloud desktop OAuth credential downloaded from Google Cloud Console.
GOOGLE_CREDENTIALS_PATH=./credentials/credentials.json
GOOGLE_TOKEN_PATH=./credentials/token.json

# Gmail query. Keep this narrow in the sandbox to avoid processing old mail.
GMAIL_QUERY=newer_than:2d ("Booked appointment" OR "Rescheduled appointment" OR "Cancelled appointment" OR "Canceled appointment") -label:THB-VisitLogger-Processed -label:THB-VisitLogger-Error
GMAIL_PROCESSED_LABEL=THB-VisitLogger-Processed
GMAIL_ERROR_LABEL=THB-VisitLogger-Error
REI_URL_PATTERN=reiblackbook
MAX_EMAILS_PER_RUN=10

# Sandbox Google Sheet. Use the DEV copy spreadsheet ID, not the production sheet.
SPREADSHEET_ID=PASTE_SANDBOX_SPREADSHEET_ID
TRACKER_SHEET=Visit Tracker DEV
TRACKER_HEADER_ROW=1
ADD_MISSING_COLUMNS=true

# Calendar. "primary" is allowed, but a dedicated sandbox calendar is safer.
CALENDAR_ID=primary
# Preferred: target a calendar by its NAME (must be shared with edit rights).
CALENDAR_NAME=Juan's Official Calendar
CALENDAR_TIMEZONE=America/Los_Angeles
DEFAULT_VISIT_DURATION_MINUTES=60

# Persistent Playwright profile. Never commit this directory.
REI_USER_DATA_DIR=./browser-data/rei-sandbox
REI_LOGIN_URL=https://my.reiblackbook.com/
REI_HEADLESS=false
REI_PAGE_TIMEOUT_MS=45000
REI_SELECTOR_CONFIG=./config/rei-selectors.json

# Processing behavior.
POLL_INTERVAL_MINUTES=5
STRICT_VALIDATION=true
DRY_RUN=false
DEBUG_CAPTURE=true
LOG_LEVEL=info

# ---- WhatsApp group automation (optional) ----
# Team numbers that go in every visit group. Comma-separated. Any format; +1 is assumed for
# 10-digit US numbers. A number that cannot be parsed cleanly is skipped, never guessed.
WHATSAPP_TEAM_NUMBERS=
# The number this browser profile is logged in as, so it is not added to its own group.
WHATSAPP_OWN_NUMBER=
# Keep this false. These groups are a team/photo space. true adds the seller from the REI contact to
# every visit group, where they can read anything posted in it — offer numbers, motivation notes,
# equity estimates. That is a negotiating position, not just a privacy question.
WHATSAPP_INCLUDE_SELLER=false
# The group name. {fullAddress} matches the groups the team already builds by hand: the whole address,
# no date. Changing this means new groups stop matching the old ones by name.
WHATSAPP_GROUP_TEMPLATE={fullAddress}
WHATSAPP_LOOKAHEAD_DAYS=30
WHATSAPP_USER_DATA_DIR=./browser-data/whatsapp
# The ONE write to REI: mark a booked-appointment task complete after the visit is confirmed on
# Juan's calendar AND a WhatsApp group exists. Everything else about REI stays read-only.
REI_COMPLETE_TASKS=false
# Post the PROPERTY INSPECTION note into the group after creating it. ON by default — the briefing is
# the point of the group. This is the ONLY thing in the project that sends a message, and it only ever
# types into a conversation whose header it has read back and matched to the group name.
# It refuses to post if a seller is in the group and the note covers equity, motivation or offer
# limits — which the blank template does, by naming those headings.
# Set to false to create groups silently.
WHATSAPP_POST_NOTE=true
# Google Chat webhook the scheduled runs report to: a visit logged, a group created, a task closed, or
# a failure with the reason. Once this runs on a timer nobody opens a terminal, so silence has to mean
# "nothing was booked" rather than "it broke hours ago". Blank = no notifications.
# Use the SAME webhook URL the workbook's Apps Script uses, so everything lands in one space.
# This is a credential — anyone holding it can post into the space. It belongs here, never in source.
CHAT_WEBHOOK_URL=
# The per-lead alerts, on or off, WITHOUT touching the credential above.
#
# "but we need to turn off the auto alert." Set this to off and the re-check stops posting about individual
# leads — no cancellation notices, no gift notices, nothing per lead. Deleting CHAT_WEBHOOK_URL would do the
# same, but that is a credential you would then have to find and paste back.
#
# The 11am and 3pm work queue is NOT affected: Apps Script posts that from its own Script Properties inside
# the workbook. So the digest keeps arriving and the interruptions stop.
#
# A moved visit already posts nothing at all, whatever this is set to.
# Stop the automation running on its own. Nothing is read, written or posted while this is set.
# A run somebody TYPES can still go ahead by adding --force.
# scripts\pause.cmd and scripts\resume.cmd do the same thing without editing this file.
# NOTE: the 11am/3pm Chat digest is posted by Apps Script from Google, not from this PC, so it is
# NOT covered — delete its triggers in the Apps Script editor to stop that too.
AUTOMATION_PAUSED=false

# The full PROPERTY INSPECTION briefing in Google Chat. OFF — it belongs to the WhatsApp group.
# The booking still reaches the tracker, the dashboard, Juan's calendar and the 11am/3pm work queue.
CHAT_VISIT_BRIEFING=false

CHAT_ALERTS=on
# WhatsApp: OFF, and this is not a setting worth changing. Automating WhatsApp Web breaches Meta's terms of
# service and they detect it — THREE numbers used on this project have now been banned or restricted, the last
# one on a run with the warm-up off, a 20-minute gap between sessions, a cap of five a day, and one single
# group created. The problem is the automation, not the volume, so no combination of the limits below makes it
# safe. The official WhatsApp Business Cloud API cannot create groups at all, so there is no compliant
# alternative either.
# The visit briefing goes to Google Chat instead (CHAT_WEBHOOK_URL above) — your own Workspace, permitted to
# automate, and the part that actually carried the value. Create the group by hand; it takes a few seconds.
WHATSAPP_ENABLED=false
# WHATSAPP_SEED_ONLY=true: create the group with ONE member and send nothing at all. The members still to
# add, and the briefing to paste, go to Google Chat for a colleague to finish by hand.
#
# Asked for by the client after the third ban. It is less exposure than the full mode — one contact instead
# of four, and no message sending, which is the most detected action of the lot. It is NOT protection: every
# ban so far happened on an already-logged-in profile, and the third created exactly one group. Run it on a
# number the business can afford to lose.
#
# Needs WHATSAPP_ENABLED=true as well. On its own it does nothing.
WHATSAPP_SEED_ONLY=false
# If you do run it, these three keep the footprint small. They are what makes the difference between
# "a person using WhatsApp" and "a bot", and one account has already been banned here.
#
# SAVE THE TEAM NUMBERS AS CONTACTS on the phone, then set this true. The warm-up reloads the whole of
# WhatsApp Web once per number and exists only because the group picker cannot find unsaved numbers.
# Skipping it removes the noisiest thing this does.
WHATSAPP_SKIP_WARMUP=false
# Minimum minutes between sessions that actually open WhatsApp. The timer fires every 2 minutes; without
# this a busy morning is forty sessions an hour from one machine.
WHATSAPP_MIN_MINUTES_BETWEEN=20
# Hard cap on groups created in a day. Bulk group creation is the behaviour most associated with bans,
# and a runaway loop would look exactly like it from outside.
WHATSAPP_MAX_GROUPS_PER_DAY=5
