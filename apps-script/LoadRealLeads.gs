function loadRealLeads() {
  var sh = dataSheet_();
  if (!sh) { SpreadsheetApp.getUi().alert('Run "Build structure (setup)" first.'); return; }
  var start = CFG.FIRST_DATA_ROW, n = LEADS.length;

  // 1. Clear existing input data (leave headers + formula columns' formulas).
  var last = Math.max(sh.getLastRow(), start);
  for (var i = 0; i < HEADERS.length; i++) {
    if (COMPUTED_HEADERS.indexOf(HEADERS[i]) < 0) {
      sh.getRange(start, i + 1, last - start + 1, 1).clearContent();
    }
  }

  // 2. Write leads column-by-column (only columns present in the data).
  var used = {};
  LEADS.forEach(function(r){ Object.keys(r).forEach(function(h){ used[h] = true; }); });
  var skipped = [];
  Object.keys(used).forEach(function(h){
    var c;
    try { c = col(h); } catch (e) { skipped.push(h); return; }
    if (!c) { skipped.push(h); return; }
    var arr = LEADS.map(function(r){ return [ r[h] === undefined ? '' : r[h] ]; });
    try { sh.getRange(start, c, n, 1).setValues(arr); } catch (e) { skipped.push(h); }
  });

  SpreadsheetApp.flush();
  SpreadsheetApp.getActive().toast(
    n + ' real leads loaded into the DEV COPY.' + (skipped.length ? ' Skipped cols: ' + skipped.join(', ') : '') +
    ' Open the Cherry Opportunity Board.', 'Twin Visit Logger', 9);
}
