# Copy to .env.local for local dev; set the same vars in Vercel → Project → Settings → Environment Variables.

# Google OAuth (Google Cloud Console → APIs & Services → Credentials → OAuth client ID, type "Web application")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# NextAuth
NEXTAUTH_SECRET=            # generate: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000     # in Vercel set to your production URL, e.g. https://twin-visit-logger.vercel.app

# Restrict sign-in to these Google Workspace domains (comma-separated)
ALLOWED_DOMAINS=equitytrack.org,twinhomebuyer.com

# The Apps Script Web App /exec URL + the shared token (must equal CFG.API_TOKEN in the Apps Script)
APPS_SCRIPT_URL=
APPS_SCRIPT_TOKEN=
